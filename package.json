{
  "name": "straightedge-quoting",
  "version": "1.0.0",
  "description": "Straightedge \u2014 instant quoting and ordering for machined plastics, CNC routing and 3D printing",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npx vite --port 3001",
    "build": "node scripts/seo/gen-catalog.js && cd client && npm ci --include=dev && npm run build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node scripts/run-tests.js",
    "postinstall": "cd client && npm ci --include=dev"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.1.4",
    "fast-xml-parser": "^5.12.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "occt-import-js": "^0.0.23",
    "pdfkit": "^0.13.0",
    "sql.js": "^1.9.0",
    "stripe": "^14.0.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
