# Server
PORT=3000
NODE_ENV=development
# Public base URL. Used for Stripe return URLs and for links in emails
# (order pages, firm-quote accept links) — set it in production.
FRONTEND_URL=https://straightedgemfg.com

# Database
USE_SQLITE=true

# JWT Authentication
JWT_SECRET=change-this-to-a-random-string-in-production

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
# Required in production for the webhook (unsigned webhooks are refused).
# Without it, orders are still marked paid when the buyer returns from Stripe.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Uploaded-file handling
# Set to enable at-rest AES-256-GCM encryption of customer files: CAD uploads,
# drawings attached to quotes, and RFQ attachments. Leave unset to store them
# unencrypted (default). The owner generates the key and enters it in Railway;
# it must be 32+ random characters and must never be committed, logged or sent
# in chat. Steps: docs/security/file-encryption.md
# NORD_FILE_ENC_KEY=   (name kept for existing deployments)
# Hours to keep uploaded files before the retention sweep deletes them (default 168 = 7 days).
# UPLOAD_RETENTION_HOURS=168

# Email (Resend) — RFQ acknowledgements, firm quotes, order confirmations,
# shipping notices, and the shop's own notifications. Every send is a logged
# no-op until BOTH EMAIL_API_KEY and EMAIL_FROM are set.
# Preview the templates without sending: node scripts/preview-emails.js
# EMAIL_API_KEY=re_...
# EMAIL_FROM="Straightedge <quotes@straightedgemfg.com>"
# Where shop notifications go (new RFQ, new order, quote accepted).
# Falls back to ADMIN_EMAIL, then the address in shared/brand.json.
# RFQ_NOTIFY_TO=quotes@straightedgemfg.com
# Tests only: also write every outgoing message to this folder as JSON. Ignored unless the
# explicit test switch SE_TEST_HOOKS=1 is set (never on the live site: messages carry signed links).
# EMAIL_OUTBOX_DIR=./data/outbox

# Owner account auto-promoted to admin on startup
# ADMIN_EMAIL=owner@example.com

# Shipping (EasyPost)
# EASYPOST_API_KEY=EZTKxxxxxxxxxx

# Bot check (Cloudflare Turnstile) — off until BOTH are set. See docs/security/hardening-2026-11-11-accounts.md
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Admin: session length in hours (default 4), and the one-shot way back in (verify-email | reset-2fa; remove after use)
# ADMIN_SESSION_HOURS=4
# ADMIN_RECOVERY=

# ─── Limits (server/security/limits.js) ──────────────────────────────────────
# Every limit has a safe default; set a variable only to change it. A value that
# is not a number, or is outside its sane range, is ignored (the default stays).
# Full list with reasons: docs/security/hardening-2026-11-11-server.md
# UPLOAD_MAX_FILE_MB=50            # largest CAD file
# UPLOAD_MAX_FILES=10              # files per upload
# UPLOAD_DAILY_MB_PER_IP=500       # bytes one address may upload in 24 hours
# UPLOAD_DIR_MAX_MB=2048           # ceiling on data/uploads + drawings + part-payloads; new files refused past it
# DB_MAX_MB=256                    # database size past which new uploads are refused (a backstop: rows are small now)
# PART_INLINE_MESH_KB=16           # a part's preview mesh larger than this is a file under data/part-payloads, not a database row
# PART_INLINE_GEOMETRY_KB=64       # the same for oversized geometry detail (hundreds of holes, a dense DXF)
# PARSE_CONCURRENCY=2              # files parsed at once (worker threads)
# PARSE_QUEUE_MAX=8                # files that may wait; beyond that: "busy, try again" (503)
# PARSE_TIMEOUT_MS=60000           # per-file parse budget; the worker is stopped at this point
# PARSE_MAX_HEAP_MB=768            # V8 heap per parse worker
# PARSE_RSS_LIMIT_MB=1024          # memory parsing may add to the process before a parse is stopped (0 = off)
# MESH_MAX_TRIANGLES=500000        # STL / 3MF / tessellated STEP ceiling; larger goes to a firm quote
# DXF_MAX_ENTITIES=100000
# JSON_BODY_LIMIT_KB=1024
# TRUST_PROXY_HOPS=1               # Railway's edge = 1. With Cloudflare proxying in front of Railway: 2
# Older file-encryption keys that may still decrypt (comma-separated), for changing
# NORD_FILE_ENC_KEY without losing stored files. See docs/security/file-encryption.md
# NORD_FILE_ENC_KEY_PREVIOUS=

# ─── Availability fixes, 2026-11-11 (docs/security/availability-fixes-2026-11-11.md) ──
# Memory: set this to the memory limit of the Railway service (Settings → Resources), in MB.
# The parse workers' heap (3/8), the parsing memory watchdog (1/2) and the database ceiling (1/16,
# between 64 and 256 MB) derive from it. Default 1024 (a 1 GB container): heap 384, watchdog 512, database 64.
#   2 GB → MEMORY_BUDGET_MB=2048 (heap 768, watchdog 1024, database 128)
#   4 GB → MEMORY_BUDGET_MB=4096 (heap 1536, watchdog 2048, database 256)
# An explicit PARSE_MAX_HEAP_MB / PARSE_RSS_LIMIT_MB / DB_MAX_MB above still wins over the derived value.
# MEMORY_BUDGET_MB=1024
# Answers
# JSON_ANSWER_MAX_MB=16                 # no JSON answer larger than this leaves the API
# PART_PAYLOAD_SERVE_MAX_MB=24          # largest stored preview / geometry file served to a browser
# PART_PREVIEW_MB_PER_CLIENT_HOUR=600   # preview bytes one address may be served in an hour
# RATE_PART_PREVIEW_PER_15MIN=240       # preview requests per address
# Quote pricing
# QUOTE_MAX_LINES_ANON=25               # lines in one quote for a visitor without an account (signed in: 100)
# QUOTE_PRICE_BUDGET_MS=3000            # main-thread work one pricing request may use
# QUOTE_PRICE_WALL_MS=20000             # longest one pricing request may take on the clock
# QUOTE_PRICE_SLICE_MS=20               # work between two turns of the event loop while pricing
# QUOTE_PRICE_WAIT_MS=4000              # how long a second pricing request from one address waits for the first
# QUOTE_PRICE_MAX_INFLIGHT=8            # pricing requests running at once, all addresses together
# QUOTE_NEW_PER_CLIENT_HOUR=30          # NEW draft quotes per address per hour (re-pricing an open quote is not counted)
# QUOTE_NEW_PER_CLIENT_DAY=120
# QUOTE_NEW_PER_ACCOUNT_HOUR=60
# QUOTE_NEW_PER_ACCOUNT_DAY=240
# QUOTE_ANON_DRAFT_HOURS=48             # a no-account draft never opened again lapses after this
# DB_DRAFT_FLUSH_MS=1500                # how long a draft re-price may wait before the database file is written
# Parsing
# PARSE_QUEUE_PER_CLIENT=2              # waiting places one address may hold
# PARSE_SECONDS_PER_CLIENT_HOUR=180     # worker time per address per hour, stopped parses included
# PARSE_SUSPECT_MINUTES=60              # after a stopped parse, that address is kept off the last free worker this long
# PARSE_TIMEOUT_DXF_MS=10000            # a DXF
# PARSE_TIMEOUT_MESH_BASE_MS=15000      # STL / 3MF: base …
# PARSE_TIMEOUT_MESH_PER_MB_MS=2000     # … plus per megabyte (never more than PARSE_TIMEOUT_MS)
# PARSE_TIMEOUT_CAD_BASE_MS=30000       # STEP / IGES: base …
# PARSE_TIMEOUT_CAD_PER_MB_MS=6000      # … plus per megabyte
# DXF_MAX_FILE_MB=20
# DXF_MAX_BLOCK_INSTANCES=20000         # block copies a DXF may expand to in total
# STL_ASCII_MAX_BYTES_PER_FACET=1000    # past this an ASCII STL counts as padded
# CAD_MAX_BLANK_PERCENT=90              # a text CAD file over 256 kB that is this blank counts as padded
# What counts as a real part
# GEOMETRY_MAX_COORD_MM=100000
# GEOMETRY_MAX_EXTENT_MM=10000
# GEOMETRY_MIN_PART_UM=1000             # largest side at least 1 mm
# GEOMETRY_MIN_THICKNESS_UM=10          # every side of a 3D model at least 0.01 mm
# Storage and the database
# UPLOAD_STORED_MB_PER_IP=400           # bytes one address may have STORED at once
# UPLOAD_DIR_RESERVED_PERCENT=15        # share of the file ceiling kept for customers with a confirmed email
# STORAGE_EVICT_MIN_AGE_MINUTES=30      # an upload is not evicted under pressure until idle this long
# DB_SWEEP_PERCENT=80                   # at this share of DB_MAX_MB the oldest no-account drafts are removed
# DB_RESERVED_PERCENT=15                # share of the database ceiling kept for customers with a confirmed email
# DRAFT_SWEEP_MIN_AGE_MINUTES=30
# RFQ_CLOSED_ATTACHMENT_DAYS=14         # days after a request is declined, lost or expired before its attachment is deleted
# UPLOAD_ORPHAN_MINUTES=15              # an upload with no part row (interrupted parse) is deleted after this
# Site-wide caps
# HUMAN_TOKEN_MAX_USES=2000             # uses of one verified-human token in its hour
# RFQ_UNVERIFIED_PER_HOUR_SITE=30       # requests per hour, whole site, from senders who did not pass the robot check
# MAIL_UNCONFIRMED_PER_HOUR_SITE=60     # emails per hour, whole site, to addresses nobody has confirmed
# MAIL_SHOP_REQUESTS_PER_HOUR_SITE=40   # new-request notices per hour to the shop's inbox
# DRAFT_SWEEP_URGENT_MIN_AGE_MINUTES=5  # the same wait once visitors without an account are being turned away (database past 100 - DB_RESERVED_PERCENT)
# PART_INLINE_GEOMETRY_KB=8             # default is now 8 (the line above still shows the old 64): geometry detail over this goes to a per-part file, not the database row
# PARSE_TIMEOUT_CAD_PER_MB_MS=10000      # default is 10000 (10 s per MB on top of the 30 s base for STEP / IGES; an earlier line in this file may show 6000)
# ── Added 2026-11-12 (availability fixes, round 2). Where a line above shows another default, this is the current one. ──
# The robot check at launch: in production the server does not start without TURNSTILE_SITE_KEY and
# TURNSTILE_SECRET_KEY. To go live without them on purpose (the per-address limits still apply), set:
# ALLOW_LAUNCH_WITHOUT_BOT_CHECK=1
# Pricing: one runner for the whole site, time charged to the address and the account
# QUOTE_PRICE_SECONDS_PER_CLIENT_HOUR=120   # seconds of pricing one address may use in an hour
# QUOTE_PRICE_SECONDS_PER_ACCOUNT_HOUR=120  # the same for one account, whatever address it comes from
# QUOTE_PRICE_LIGHT_KB=256                  # a quote whose parts' stored detail is under this is "light" and never waits behind heavy ones
# QUOTE_PRICE_LIGHT_MS=150                  # a light quote that has taken this long moves to the heavy lane
# QUOTE_PRICE_HEAVY_BURST_MS=1000           # heavy quotes may run this long at full speed after a quiet spell …
# QUOTE_PRICE_HEAVY_DUTY_PERCENT=33         # … and then get this share of the time, the rest goes to everything else
# QUOTE_PRICE_QUEUE_MAX=200                 # quotes that may wait for the runner; past it "busy, try again"
# QUOTE_PRICE_QUEUE_WAIT_MS=15000           # longest wait for a turn
# QUOTE_REPRICE_PER_QUOTE_HOUR=300          # re-prices of one quote in an hour
# Draft quotes: how much one sender may hold (kilobytes as stored)
# QUOTE_DRAFT_KB_PER_CLIENT=512             # one address, quotes with no account
# QUOTE_DRAFT_KB_PER_ACCOUNT=512            # one account, quotes that are not on an order or a request
# DRAFT_KEEP_KB_PER_HOLDER=64               # under pressure nobody is taken below this
# DRAFT_SWEEP_MIN_AGE_MINUTES=2             # default is now 2, counted from creation (a line above shows 30)
# PRESSURE_BACKOFF_MINUTES=5                # after a clean-up that found nothing to remove, wait this long before looking again
# DB_MAX_MB=16                              # default is now 16, no longer derived from MEMORY_BUDGET_MB: a save is one whole-file write, about 2 ms per MB
# Stored files: how much one sender may hold
# UPLOAD_STORED_MB_PER_IP=150               # default is now 150 (a line above shows 400)
# UPLOAD_STORED_MB_PER_ACCOUNT=150          # the same for one account
# UPLOAD_PROTECTED_MB_PER_HOLDER=50         # of that, what open requests, saved quotes and unpaid orders may keep from being cleared (default: a third of the stored allowance)
# ORDER_UNPAID_PROTECT_HOURS=48             # an unpaid order keeps its files safe from clearing for this long
# LOOSE_PARTS_KEEP_PER_HOLDER=10            # uploads on no quote that one sender keeps under pressure
# CUSTOMER_PART_KEEP_MINUTES=60             # a signed-in customer's upload is never cleared before this
# STORAGE_EVICT_MIN_AGE_MINUTES=2           # default is now 2, counted from upload (a line above shows 30)
# Site-wide caps: each address's first few are outside them
# RFQ_UNVERIFIED_FREE_PER_CLIENT_HOUR=2     # requests per address per hour that the site-wide cap never refuses
# MAIL_UNCONFIRMED_FREE_PER_CLIENT_HOUR=2   # emails per address per hour to unconfirmed recipients that the site-wide cap never holds
# MAIL_UNCONFIRMED_HARD_PER_HOUR_SITE=300   # past this even those are held and sent when the hour turns
# MAIL_HELD_PER_CLIENT=3                    # emails held for later per address
# VERIFY_RESEND_PER_CLIENT_HOUR=5           # "send it again" per address per hour
# Reading files: limits are on the work done, not on the clock
# PARSE_WALL_FACTOR=4                       # on the clock a parse may take this many times its limit when the machine is busy …
# PARSE_WALL_TIMEOUT_MS=120000              # … and never more than this
# PARSE_RSS_SOLO_LIMIT_MB=634               # memory one parse running by itself may add (default 62 % of MEMORY_BUDGET_MB)
# PARSE_RSS_CEILING_MB=942                  # resident memory of the whole process at which parsing gives way (default 92 % of MEMORY_BUDGET_MB; 0 = off)
# GEOMETRY_MIN_PRINT_WALL_UM=400            # a printed part thinner than this goes to a person
