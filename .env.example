# Server
PORT=3000
NODE_ENV=development
# Public base URL. Used for Stripe return URLs and for links in emails
# (order pages, firm-quote accept links) — set it in production.
FRONTEND_URL=https://straightedgemfg.com

# Database
USE_SQLITE=true

# JWT Authentication
JWT_SECRET=change-this-to-a-random-string-in-production

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
# Required in production for the webhook (unsigned webhooks are refused).
# Without it, orders are still marked paid when the buyer returns from Stripe.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Uploaded-file handling
# Set to enable at-rest AES-256-GCM encryption of uploaded customer CAD files.
# Leave unset to store files unencrypted (default). Use a long random string.
# NORD_FILE_ENC_KEY=change-this-to-a-long-random-string   (name kept for existing deployments)
# Hours to keep uploaded files before the retention sweep deletes them (default 168 = 7 days).
# UPLOAD_RETENTION_HOURS=168

# Email (Resend) — RFQ acknowledgements, firm quotes, order confirmations,
# shipping notices, and the shop's own notifications. Every send is a logged
# no-op until BOTH EMAIL_API_KEY and EMAIL_FROM are set.
# Preview the templates without sending: node scripts/preview-emails.js
# EMAIL_API_KEY=re_...
# EMAIL_FROM="Straightedge <quotes@straightedgemfg.com>"
# Where shop notifications go (new RFQ, new order, quote accepted).
# Falls back to ADMIN_EMAIL, then the address in shared/brand.json.
# RFQ_NOTIFY_TO=quotes@straightedgemfg.com
# Dev/test only: also write every outgoing message to this folder as JSON.
# EMAIL_OUTBOX_DIR=./data/outbox

# Owner account auto-promoted to admin on startup
# ADMIN_EMAIL=erik@erik-lutz.com

# Shipping (EasyPost)
# EASYPOST_API_KEY=EZTKxxxxxxxxxx

# Bot check (Cloudflare Turnstile) — off until BOTH are set. See docs/security/hardening-2026-11-11-accounts.md
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Admin: session length in hours (default 4), and the one-shot way back in (verify-email | reset-2fa; remove after use)
# ADMIN_SESSION_HOURS=4
# ADMIN_RECOVERY=
