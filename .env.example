# Server
PORT=3000
NODE_ENV=development
# Public base URL. Used for Stripe return URLs and for links in emails
# (order pages, firm-quote accept links) — set it in production.
FRONTEND_URL=https://straightedgemfg.com

# Database
USE_SQLITE=true

# JWT Authentication
JWT_SECRET=change-this-to-a-random-string-in-production

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
# REQUIRED in production: the server does not start without it. The signing secret of this site's
# webhook endpoint in Stripe (starts whsec_; test mode and live mode have different ones).
# Enable six event types on that endpoint: checkout.session.completed, checkout.session.expired,
# charge.refunded, refund.updated, charge.dispute.created, charge.dispute.closed.
# STRIPE_WEBHOOK_SECRET=whsec_...
# Promotion codes on Stripe's page: off unless this is "on" (then every active code works on every order).
# STRIPE_PROMOTION_CODES=on
# Minutes a payment page stays open (30-1440, default 120). After that the unpaid order closes and its quote can be ordered again.
# CHECKOUT_SESSION_MINUTES=120

# Uploaded-file handling
# Set to enable at-rest AES-256-GCM encryption of customer files: CAD uploads,
# drawings attached to quotes, and RFQ attachments. Leave unset to store them
# unencrypted (default). The owner generates the key and enters it in Railway;
# it must be 32+ random characters and must never be committed, logged or sent
# in chat. Steps: docs/security/file-encryption.md
# NORD_FILE_ENC_KEY=   (name kept for existing deployments)
# Older file-encryption keys that may still decrypt (comma-separated), for changing
# NORD_FILE_ENC_KEY without losing stored files. See docs/security/file-encryption.md
# NORD_FILE_ENC_KEY_PREVIOUS=
# Hours to keep uploaded files before the retention sweep deletes them (default 168 = 7 days).
# UPLOAD_RETENTION_HOURS=168
# Hours a drawing attached to no quote is kept before it is deleted (default 24).
# DRAWING_ORPHAN_HOURS=24

# Email (Resend) — RFQ acknowledgements, firm quotes, order confirmations,
# shipping notices, and the shop's own notifications. Every send is a logged
# no-op until BOTH EMAIL_API_KEY and EMAIL_FROM are set.
# Preview the templates without sending: node scripts/preview-emails.js
# EMAIL_API_KEY=re_...
# EMAIL_FROM="Straightedge <quotes@straightedgemfg.com>"
# Where shop notifications go (new RFQ, new order, quote accepted).
# Falls back to ADMIN_EMAIL, then the address in shared/brand.json.
# RFQ_NOTIFY_TO=quotes@straightedgemfg.com
# Tests only: also write every outgoing message to this folder as JSON. Ignored unless the
# explicit test switch SE_TEST_HOOKS=1 is set (never on the live site: messages carry signed links).
# EMAIL_OUTBOX_DIR=./data/outbox

# The address of the admin account. It NAMES the account; nothing promotes an account to admin by its email.
# An admin account that already exists is left as it is. When there is none, it is made once at /admin/setup
# with ADMIN_SETUP_CODE: a code the owner invents (20+ characters, never a word), sets here, uses once and removes.
# ADMIN_EMAIL=owner@example.com
# ADMIN_SETUP_CODE=

# Shipping and sales tax have no variables here. How shipping is charged (weight formula, rate table,
# included), the buyer's-own-carrier and pickup choices, and sales tax (off, or Stripe Tax) are settings
# in Admin → Pricing → "Shipping & tax", saved with a note like any other rule and off or at their
# original behaviour by default. Stripe Tax uses the same STRIPE_SECRET_KEY: docs/launch/tax-and-shipping.md

# Bot check (Cloudflare Turnstile). REQUIRED in production: the server does not start without BOTH keys
# (it prints one line naming what is missing and exits). They come from the Cloudflare dashboard, Turnstile,
# the widget for this site: docs/launch/go-live-runbook.md, "Before you start", part B.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# To run in production mode WITHOUT the bot check on purpose (a local test, a QA script), say so:
# uploads, quotes and the request form are then open to scripts, held back only by the per-address limits below.
# ALLOW_LAUNCH_WITHOUT_BOT_CHECK=1
# Browser content policy. Enforced by default. "true" only reports what it would block and blocks nothing:
# for finding out what a new third-party script needs, never left on (Admin → System shows it as a problem).
# CSP_REPORT_ONLY=true
# Admin: session length in hours (default 4), and the one-shot ways back in (remove after use):
#   reset-2fa    lost the phone and the recovery codes: two-step sign-in is switched off so it can be enrolled again
#   setup-code   locked out with no working mailbox: reopens /admin/setup for ADMIN_EMAIL; needs a NEW ADMIN_SETUP_CODE
# ADMIN_SESSION_HOURS=4
# ADMIN_RECOVERY=

# ─── Limits (server/security/limits.js) ──────────────────────────────────────
# Every limit the server reads is listed here ONCE, with its default. Set a variable only to change it;
# a value that is not a number, or is outside its sane range, is ignored (the default stays).
# server/security/envExample.test.js fails if a limit is added to the code and not to this list, is listed
# twice, or is shown with a default the code does not have.
# Why each one is what it is: docs/security/hardening-2026-11-11-server.md (uploads, parsing),
# docs/security/availability-fixes-2026-11-11.md and availability-fixes-round2-2026-11-12.md (everything per sender).
#
# Memory. The ONE setting to match to the Railway service (Settings → Resources → memory limit), in MB.
# The parse limits marked "derived" below follow it. Recommended service size: 2 GB with MEMORY_BUDGET_MB=2048
# (at the 1024 default the largest meshes, 500,000 triangles of loose geometry, are read alone and then sent to a person).
# MEMORY_BUDGET_MB=1024
#
# Checkout
# CHECKOUT_PER_ACCOUNT_15MIN=12             # times one account may press pay in 15 minutes
# ORDERS_UNPAID_PER_ACCOUNT=3               # orders one account may have waiting for a card payment at once
# ORDERS_UNPAID_PER_CLIENT=5                # the same, per address
# ORDERS_UNPAID_NEW_PER_ACCOUNT_DAY=8       # checkouts one account may start and leave unpaid in 24 hours
# ORDERS_UNPAID_NEW_PER_CLIENT_DAY=16       # the same, per address
#
# Drawing units
# UNITS_CHANGES_PER_CLIENT_10MIN=30         # times one address, and one account, may change a DXF's units in 10 minutes
#
# Uploads
# UPLOAD_MAX_FILE_MB=50                     # largest CAD file
# UPLOAD_MAX_FILES=10                       # files per upload
# UPLOAD_DAILY_MB_PER_IP=500                # bytes one address may send in 24 hours (bytes of a refused upload count too)
# DRAWING_MAX_FILE_MB=25                    # largest drawing (PDF) attached to an instant quote
# UPLOAD_ORPHAN_MINUTES=15                  # an upload with no part row (an interrupted parse) is deleted after this
#
# Stored files: the ceiling, what one sender may hold, and who gives way when it is nearly full
# UPLOAD_DIR_MAX_MB=2048                    # ceiling on data/uploads + drawings + part-payloads; new files refused past it
# UPLOAD_DIR_WARN_PERCENT=80                # at this share the clean-up starts (and a warning is logged)
# UPLOAD_DIR_RESERVED_PERCENT=15            # share kept for customers with a confirmed email: visitors without an account stop at 100 minus this
# UPLOAD_STORED_MB_PER_IP=150               # files one address may have stored at once
# UPLOAD_STORED_MB_PER_ACCOUNT=150          # the same for one account
# UPLOAD_PROTECTED_MB_PER_HOLDER=50         # of that, what unanswered requests, saved quotes and lapsed unpaid orders keep from the clean-up (derived: a third of UPLOAD_STORED_MB_PER_IP)
# CUSTOMER_PART_KEEP_MINUTES=60             # a signed-in customer's upload is never cleared before this
# STORAGE_EVICT_MIN_AGE_MINUTES=2           # no file is cleared in its first minutes, counted from upload
# RFQ_CLOSED_ATTACHMENT_DAYS=14             # days after a request is declined, lost or expired before its attachment is deleted
#
# The database: the ceiling, what one sender may hold, and who gives way
# DB_MAX_MB=16                              # database ceiling. A save rewrites the whole file: about 1 to 3 ms per MB. Raise it when Admin → System shows the database near 80 %
# DB_SWEEP_PERCENT=80                       # at this share the clean-up takes drafts and loose uploads from whoever holds the most
# DB_RESERVED_PERCENT=15                    # share kept for customers with a confirmed email: visitors without an account stop at 100 minus this
# DB_DRAFT_FLUSH_MS=1500                    # how long a re-priced draft may wait before the database file is written (flushed at once on shutdown)
# DB_SAVE_RETRY_MS=15000                   # when a write of the database file fails (a full disk), how often it is tried again without anybody asking; the health check answers "unavailable" until one succeeds
# QUOTE_DRAFT_KB_PER_CLIENT=512             # stored draft quotes of one address, no account (a one-line draft is about 3 kB as stored, 25 lines 8 kB, 100 lines 21 kB)
# QUOTE_DRAFT_KB_PER_ACCOUNT=512            # stored draft quotes of one account that are on no order or request
# DRAFT_KEEP_KB_PER_HOLDER=64               # under pressure nobody is taken below this
# LOOSE_PARTS_KEEP_PER_HOLDER=10            # uploads on no quote that one sender keeps under pressure
# DRAFT_SWEEP_MIN_AGE_MINUTES=2             # no row is cleared in its first minutes, counted from creation
# DRAFT_SWEEP_URGENT_MIN_AGE_MINUTES=5      # no longer used (still read without error)
# PRESSURE_BACKOFF_MINUTES=5                # after a clean-up that found nothing it may remove, wait this long before looking again
# QUOTE_ANON_DRAFT_HOURS=48                 # a no-account draft never opened again lapses after this
# PART_INLINE_MESH_KB=16                    # a preview mesh larger than this is a file under data/part-payloads, not a database row
# PART_INLINE_GEOMETRY_KB=8                 # the same for geometry detail (hundreds of holes, a dense DXF)
#
# Reading files (worker threads). Time limits are on the work done (CPU time), with a ceiling on the clock.
# PARSE_CONCURRENCY=2                       # files read at once (default: 2, or 1 on a single-core machine)
# PARSE_PER_CLIENT=1                        # of those, how many one address may have running
# PARSE_QUEUE_MAX=8                         # files that may wait; beyond that "busy, try again" (503)
# PARSE_QUEUE_PER_CLIENT=2                  # waiting places one address may hold
# PARSE_QUEUE_WAIT_MS=30000                 # longest a file waits for a worker
# PARSE_SECONDS_PER_CLIENT_HOUR=180         # worker time per address per hour, stopped parses included
# PARSE_SUSPECT_MINUTES=60                  # after a stopped parse, that address is kept off the last free worker this long
# PARSE_TIMEOUT_MS=60000                    # the most any one file gets
# PARSE_TIMEOUT_DXF_MS=10000                # a DXF
# PARSE_TIMEOUT_MESH_BASE_MS=15000          # STL / 3MF: base …
# PARSE_TIMEOUT_MESH_PER_MB_MS=2000         # … plus per megabyte
# PARSE_TIMEOUT_CAD_BASE_MS=30000           # STEP / IGES: base …
# PARSE_TIMEOUT_CAD_PER_MB_MS=10000         # … plus per megabyte
# PARSE_WALL_FACTOR=4                       # on the clock a parse may take this many times its limit when the machine is busy …
# PARSE_WALL_TIMEOUT_MS=120000              # … and never more than this
# PARSE_MAX_HEAP_MB=384                     # heap of one parse worker (derived: 3/8 of MEMORY_BUDGET_MB)
# PARSE_RSS_LIMIT_MB=512                    # memory two or more parses together may add before one is stopped and run again alone (derived: half of MEMORY_BUDGET_MB; 0 = off)
# PARSE_RSS_SOLO_LIMIT_MB=634               # memory one parse running alone may add; past it the file goes to a person (derived: 62 % of MEMORY_BUDGET_MB)
# PARSE_RSS_CEILING_MB=942                  # resident memory of the whole process at which parsing gives way (derived: 92 % of MEMORY_BUDGET_MB; 0 = off)
#
# Model size ceilings (bigger models go to a firm quote)
# MESH_MAX_TRIANGLES=500000                 # STL / 3MF / tessellated STEP
# DXF_MAX_ENTITIES=100000
# DXF_MAX_FILE_MB=20
# DXF_MAX_BLOCK_INSTANCES=20000             # block copies a DXF may expand to in total
# STL_ASCII_MAX_BYTES_PER_FACET=1000        # past this an ASCII STL counts as padded
# CAD_MAX_BLANK_PERCENT=90                  # a text CAD file over 256 kB that is this blank counts as padded
#
# What counts as a real part (a model outside these is refused and offered a firm quote)
# GEOMETRY_MAX_COORD_MM=100000              # no coordinate further than this from the origin
# GEOMETRY_MAX_EXTENT_MM=10000              # no side longer than this
# GEOMETRY_MIN_PART_UM=1000                 # largest side at least 1 mm
# GEOMETRY_MIN_THICKNESS_UM=10              # every side of a 3D model at least 0.01 mm
# GEOMETRY_MIN_PRINT_WALL_UM=400            # a printed part thinner than this goes to a person
#
# 3MF (a ZIP archive)
# ZIP_MAX_ENTRIES=1000
# ZIP_MAX_TOTAL_MB=256                      # declared uncompressed size of all entries
# ZIP_MAX_MODEL_MB=64                       # uncompressed size of the model entry that is read
# ZIP_MAX_RATIO=100                         # uncompressed : compressed ratio past which an entry is treated as a bomb
# XML_MAX_DEPTH=32
#
# Requests and answers
# JSON_BODY_LIMIT_KB=1024
# JSON_ANSWER_MAX_MB=16                     # no JSON answer larger than this leaves the API
# PART_PAYLOAD_SERVE_MAX_MB=24              # largest stored preview / geometry file served to a browser
# PART_PREVIEW_MB_PER_CLIENT_HOUR=600       # preview bytes one address may be served in an hour
#
# Pricing a quote: one runner for the whole site, the time charged to the address and the account
# QUOTE_MAX_LINES_ANON=25                   # lines in one quote for a visitor without an account (signed in: 100)
# QUOTE_PRICE_SECONDS_PER_CLIENT_HOUR=120   # seconds of pricing one address may use in an hour
# QUOTE_PRICE_SECONDS_PER_ACCOUNT_HOUR=120  # the same for one account, whatever address it comes from
# QUOTE_PRICE_BUDGET_MS=3000                # work one pricing request may use before it is offered a firm quote
# QUOTE_PRICE_WALL_MS=20000                 # longest one pricing request may take on the clock
# QUOTE_PRICE_SLICE_MS=20                   # work between two turns of the event loop
# QUOTE_PRICE_WAIT_MS=4000                  # how long a second pricing request from one address waits for the first
# QUOTE_PRICE_LIGHT_KB=256                  # a quote whose parts carry less stored detail than this is "light" and never waits behind heavy ones
# QUOTE_PRICE_LIGHT_MS=150                  # a light quote that has taken this long moves to the heavy lane
# QUOTE_PRICE_HEAVY_BURST_MS=1000           # heavy quotes may run this long at full speed after a quiet spell …
# QUOTE_PRICE_HEAVY_DUTY_PERCENT=33         # … and then get this share of the time
# QUOTE_PRICE_QUEUE_MAX=200                 # quotes that may wait for the runner; past it "busy, try again"
# QUOTE_PRICE_QUEUE_WAIT_MS=15000           # longest wait for a turn
# QUOTE_PRICE_MAX_INFLIGHT=8                # no longer used (still read without error)
# QUOTE_REPRICE_PER_QUOTE_HOUR=300          # re-prices of one quote in an hour
# QUOTE_NEW_PER_CLIENT_HOUR=30              # NEW draft quotes per address per hour (re-pricing an open quote is not counted)
# QUOTE_NEW_PER_CLIENT_DAY=120
# QUOTE_NEW_PER_ACCOUNT_HOUR=60
# QUOTE_NEW_PER_ACCOUNT_DAY=240
#
# Site-wide caps. Each address's first few are outside them, so nobody's first action is refused.
# HUMAN_TOKEN_MAX_USES=2000                 # uses of one verified-human token in its hour
# RFQ_UNVERIFIED_PER_HOUR_SITE=30           # requests per hour, whole site, from senders who did not pass the bot check
# RFQ_UNVERIFIED_FREE_PER_CLIENT_HOUR=2     # requests per address per hour that the cap above never refuses
# MAIL_UNCONFIRMED_PER_HOUR_SITE=60         # emails per hour, whole site, to addresses nobody has confirmed; past it they are held and sent when the hour turns
# MAIL_UNCONFIRMED_FREE_PER_CLIENT_HOUR=2   # emails per address per hour that the cap above never holds
# MAIL_UNCONFIRMED_HARD_PER_HOUR_SITE=300   # past this even those are held
# MAIL_HELD_PER_CLIENT=3                    # emails held for later per address
# MAIL_SHOP_REQUESTS_PER_HOUR_SITE=40       # new-request notices per hour to the shop's inbox
# VERIFY_RESEND_PER_CLIENT_HOUR=5           # "send it again" per address per hour
#
# Rate limits per address
# RATE_API_PER_15MIN=200
# RATE_UPLOAD_PER_15MIN=50
# RATE_QUOTE_PER_15MIN=300
# RATE_QUOTE_BURST_PER_10SEC=40
# RATE_QUOTE_SESSION_PER_15MIN=60           # reopening a saved quote
# RATE_PART_PREVIEW_PER_15MIN=240           # 3D preview requests
# RATE_PDF_PER_15MIN=60
# RATE_DRAWING_PER_HOUR=20
# RATE_RFQ_PER_HOUR=20
# TRUST_PROXY_HOPS=1                        # Railway's edge = 1. With Cloudflare proxying in front of Railway: 2

# ─── Operations (server/ops) — added 2026-11-11 ──────────────────────────────
# Steps for each of these: docs/launch/go-live-runbook.md
#
# One public address. Set both at domain cutover, not before.
# CANONICAL_HOST=straightedgemfg.com          # the one host the site lives on (the bare domain: pages, sitemap and canonical tags are built for it)
# REDIRECT_HOSTS=www.straightedgemfg.com,nordmfg.com,www.nordmfg.com   # each answers 301 to the same path on CANONICAL_HOST
#                                             # (the health check and the Stripe webhook are never redirected)
# NOINDEX_HOSTS=                              # extra hosts that serve the site but stay out of search results; Railway's own host always does
# HSTS_ALL_HOSTS=true                         # only after cutover is verified: until then the HSTS header is sent on CANONICAL_HOST only
#
# Daily digest and alerts. Sent to RFQ_NOTIFY_TO, and only when EMAIL_API_KEY / EMAIL_FROM are set.
# OPS_DIGEST_HOUR=7                           # hour of the day, Central time (America/Chicago), 0-23
# OPS_DIGEST=off                              # switch the scheduled digest off (the admin button still works)
# OPS_ALERT_COOLDOWN_HOURS=6                  # the same alert is not emailed again inside this many hours
# OPS_ALERT_MAX_PER_DAY=12                    # most alert emails in any 24 hours
# OPS_ERROR_THRESHOLD=5                       # server errors in 15 minutes before an alert
# OPS_MAIL_FAIL_THRESHOLD=3                   # failed customer emails in an hour before an alert
# OPS_WEBHOOK_FAIL_THRESHOLD=3                # refused or failed Stripe webhooks in an hour before an alert
# OPS_VOLUME_ALERT_PERCENT=90                 # how full the volume may get before an alert
#
# Stopping and backups.
# SHUTDOWN_GRACE_MS=10000                     # how long requests in progress get to finish on SIGTERM; keep Railway's draining time above it
# BACKUP_MAX_MB=4096                          # largest data folder the "full backup" download will pack; above it, use a Railway volume backup
